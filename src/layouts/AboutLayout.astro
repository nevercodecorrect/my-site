---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    activeNav?: "about" | "cv" | "teaching" | "PrivacyPolicy";
  };
}

const { frontmatter } = Astro.props;

const pageKey = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "about";
const inferredActiveNav =
  pageKey === "cv"
    ? "cv"
    : pageKey === "teach"
      ? "teaching"
      : pageKey === "PrivacyPolicy"
        ? "PrivacyPolicy"
        : "about";

const activeNav = frontmatter.activeNav ?? inferredActiveNav;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav={activeNav} />
  <Breadcrumbs />
  <main id="main-content">
    <section id="about" class="prose mb-28 max-w-4xl prose-img:border-0">
      <p class="page-kicker">Meng Wang</p>
      <h1 class="text-3xl font-bold tracking-[-0.04em] sm:text-4xl">
        {frontmatter.title}
      </h1>
      {
        frontmatter.description && (
          <p class="lead not-italic">{frontmatter.description}</p>
        )
      }
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4;
  }

  .page-kicker {
    @apply !mb-2 !text-xs !font-semibold uppercase !tracking-[0.28em] !text-skin-accent;
  }
</style>
