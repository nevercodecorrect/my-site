---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    activeNav?: "about" | "cv" | "teaching" | "PrivacyPolicy";
  };
}

const { frontmatter } = Astro.props;

const pageKey = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "about";
const inferredActiveNav =
  pageKey === "cv"
    ? "cv"
    : pageKey === "teach"
      ? "teaching"
      : pageKey === "PrivacyPolicy"
        ? "PrivacyPolicy"
        : "about";

const activeNav = frontmatter.activeNav ?? inferredActiveNav;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav={activeNav} />
  <Breadcrumbs />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">Meng Wang</p>
      <h1>{frontmatter.title}</h1>
      {
        frontmatter.description && (
          <p class="page-lead not-italic">{frontmatter.description}</p>
        )
      }
    </section>
    <section id="about" class="prose mb-28 max-w-none prose-img:border-0">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4;
  }

  /* Fill the frame and left-align the prose so it lines up with the header
     logo and breadcrumb, matching the other pages. Overrides both the
     global `section { mx-auto px-4 }` rule and prose's default max-width. */
  #about {
    @apply mx-0 max-w-none px-0;
  }
</style>
