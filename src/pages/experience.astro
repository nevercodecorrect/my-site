---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";

// Render hyphenated date ranges with a proper en dash.
const dateRange = (s: string) => s.replace(/\s*-\s*/g, " – ");

const workItems = [
  {
    role: "Security Engineer",
    organization: "AWS Proactive Security",
    location: "New York",
    period: "Sep 2022 - Sep 2023",
    description:
      "Developed automated web vulnerability scanning to assess AWS-owned websites.",
  },
  {
    role: "Research Assistant",
    organization: "University of Virginia",
    location: "Charlottesville",
    period: "Sep 2019 - May 2022",
    description:
      "Conducted research in web security and compiler optimization.",
  },
  {
    role: "Research Assistant",
    organization: "Nanyang Technological University",
    location: "Singapore",
    period: "Dec 2018 - Mar 2019",
    description:
      "Conducted research in device-free sensing and wireless networks.",
  },
] as const;

const educationItems = [
  {
    degree: "Ph.D. in Computer Science",
    institution: "CISPA Helmholtz Center for Information Security",
    location: "Saarbrücken",
    period: "2023 - now",
  },
  {
    degree: "M.S. in Computer Science",
    institution: "University of Virginia",
    location: "Charlottesville",
    period: "2019 - 2022",
  },
  {
    degree: "B.E. in Network Security",
    institution: "Dalian University of Technology",
    location: "Dalian",
    period: "2015 - 2019",
  },
] as const;

const serviceItems = [
  {
    role: "Program Committee",
    venues: ["AsiaCCS 2027", "USENIX Security 2027"],
  },
] as const;
---

<Layout title="Experience | Meng Wang">
  <Header activeNav="experience" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">Academic and industry experience</p>
      <h1>Experience</h1>
    </section>

    <section class="content-section" aria-labelledby="service-heading">
      <h2 id="service-heading" class="section-title">Services</h2>
      <div class="entry-list">
        {
          serviceItems.map(item => (
            <article class="entry">
              <div class="entry-row">
                <p class="entry-main">
                  <span class="entry-title">{item.role}</span>
                </p>
                <p class="entry-meta">{item.venues.join(" · ")}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="content-section" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-title">Work</h2>
      <div class="entry-list">
        {
          workItems.map(item => (
            <article class="entry">
              <div class="entry-row">
                <p class="entry-main">
                  <span class="entry-title">{item.role}</span>
                  <span class="entry-org">{item.organization}</span>
                  <span class="entry-loc">{item.location}</span>
                </p>
                <p class="entry-meta">{dateRange(item.period)}</p>
              </div>
              <p class="entry-desc">{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="content-section" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-title">Education</h2>
      <div class="entry-list">
        {
          educationItems.map(item => (
            <article class="entry">
              <div class="entry-row">
                <p class="entry-main">
                  <span class="entry-title">{item.degree}</span>
                  <span class="entry-org">{item.institution}</span>
                  <span class="entry-loc">{item.location}</span>
                </p>
                <p class="entry-meta">{dateRange(item.period)}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }
</style>
