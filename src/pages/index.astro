---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Socials from "@components/Socials.astro";
import { SOCIALS } from "@config";

const focusAreas = [
  "System security",
  "Firmware analysis",
  "Fuzzing",
  "Web security",
] as const;

const workAreas = [
  {
    title: "Program Analysis for hard-to-detect threats",
    text: "Uncovering evasive threats and hard-to-find business logic vulnerabilities",
  },
  {
    title: "Firmware and UEFI fuzzing",
    text: "Finding bugs below the OS in firmware, bootloaders, system management mode, and hardware-adjacent stacks.",
  },
  {
    title: "Scalable vulnerability discovery",
    text: "Building automated systems that make deep security testing practical across large, real-world codebases.",
  },
] as const;

const newsItems = [
  {
    date: "2026",
    text: "PyFEX accepted to CCS 2026.",
  },
  {
    date: "2026",
    text: "Anota accepted to NDSS 2026.",
  },
  {
    date: "2026",
    text: "SmuFuzz accepted to IEEE Symposium on Security and Privacy 2026.",
  },
  {
    date: "2025",
    text: "Two papers accepted to NDSS 2025 on video acceleration stacks and bootloader memory safety.",
  },
] as const;

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout title="Meng Wang | System and Firmware Security">
  <Header activeNav="home" />
  <main id="main-content">
    <section id="hero" class="site-section">
      <div class="hero-copy">
        <h1>Meng Wang</h1>
        <p class="hero-summary">
          Ph.D. student at
          <a class="text-link" href="https://cispa.de/en">
            CISPA Helmholtz Center for Information Security
          </a>
          advised by
          <a class="text-link" href="https://ali-abbasi.info/">
            Dr. Ali Abbasi
          </a>. My work focuses on system and firmware security. Previously, I
          worked with AWS Proactive Security on a web vulnerability scanner for
          AWS-owned websites.
        </p>

        <div class="focus-list" aria-label="Research focus areas">
          {focusAreas.map(area => <span>{area}</span>)}
        </div>

        {
          socialCount > 0 && (
            <div class="social-wrapper">
              <span>Profiles</span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <section id="research" class="site-section split-section">
      <div class="section-heading">
        <h2>What I Work On</h2>
      </div>

      <div class="research-grid">
        {
          workAreas.map(item => (
            <article class="research-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="news" class="site-section split-section">
      <div class="section-heading">
        <p class="eyebrow">Updates</p>
        <h2>News</h2>
      </div>

      <ol class="news-list">
        {
          newsItems.map(item => (
            <li>
              <time>{item.date}</time>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }

  .site-section {
    @apply mx-auto max-w-none px-0;
  }

  .eyebrow {
    @apply mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-skin-accent;
  }

  .text-link {
    @apply font-semibold underline decoration-2 underline-offset-4 transition-colors hover:text-skin-accent;
    text-decoration-color: rgba(var(--color-accent), 0.45);
  }

  #hero {
    @apply pb-8 pt-10 sm:pb-10 sm:pt-16;
  }

  .hero-copy {
    @apply relative rounded-lg border border-skin-line bg-skin-fill p-6 shadow-[0_8px_24px_rgba(15,23,42,0.04)] sm:p-10;
  }

  .hero-copy::before {
    content: "";
    @apply absolute left-6 top-0 h-1 w-28 rounded-full bg-skin-accent sm:left-10;
  }

  #hero h1 {
    @apply mb-5 text-5xl font-bold leading-none tracking-[-0.03em] sm:text-7xl;
  }

  .hero-summary {
    @apply max-w-3xl text-base leading-8 sm:text-lg;
  }

  .focus-list {
    @apply mt-7 flex flex-wrap gap-2;
  }

  .focus-list span {
    @apply rounded-md border border-skin-line bg-skin-card/45 px-3 py-1 text-sm;
  }

  .social-wrapper {
    @apply mt-8 flex flex-col gap-2 text-sm text-skin-base/75 sm:flex-row sm:items-center;
  }

  .split-section {
    @apply py-10;
  }

  .section-heading {
    @apply mb-6;
  }

  .section-heading h2 {
    @apply text-3xl font-bold tracking-[-0.05em] sm:text-4xl;
  }

  .research-grid {
    @apply grid gap-4 sm:grid-cols-2;
  }

  @media (min-width: 1024px) {
    .research-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .research-card {
    @apply rounded-lg border border-skin-line bg-skin-card/35 p-5;
  }

  .research-card h3 {
    @apply text-lg font-semibold leading-tight tracking-[-0.03em];
  }

  .research-card p {
    @apply mt-4 text-sm leading-7 text-skin-base/70;
  }

  .news-list {
    @apply grid gap-3;
  }

  .news-list li {
    @apply grid gap-3 rounded-lg border border-skin-line bg-skin-fill p-4 shadow-[0_6px_18px_rgba(15,23,42,0.035)] sm:grid-cols-[5rem_minmax(0,1fr)] sm:items-center;
  }

  .news-list time {
    @apply text-sm font-bold text-skin-accent;
  }

  .news-list span {
    @apply leading-7 text-skin-base/75;
  }
</style>
