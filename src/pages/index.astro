---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Socials from "@components/Socials.astro";
import { SOCIALS } from "@config";

const focusAreas = [
  "System security",
  "Firmware analysis",
  "Fuzzing",
  "Web security",
] as const;

const workAreas = [
  {
    title: "Program analysis tools for hard-to-detect threats",
    text: "Uncovering evasive threats and hard-to-find business logic vulnerabilities.",
  },
  {
    title: "Low-level firmware security",
    text: "Finding bugs below the OS in firmware, bootloaders, system management mode, and hardware-adjacent stacks.",
  },
  {
    title: "Scalable vulnerability discovery",
    text: "Building automated systems that make deep security testing practical across large, real-world codebases.",
  },
] as const;

const newsItems = [
  { date: "2026", text: "PyFEX accepted to CCS 2026." },
  { date: "2026", text: "Anota accepted to NDSS 2026." },
  {
    date: "2026",
    text: "SmuFuzz accepted to IEEE S&P 2026.",
  },
  {
    date: "2025",
    text: "Two papers accepted to NDSS 2025 on video acceleration stacks and bootloader memory safety.",
  },
] as const;

const newsByYear = Object.entries(
  newsItems.reduce(
    (acc, item) => {
      (acc[item.date] ||= []).push(item.text);
      return acc;
    },
    {} as Record<string, string[]>
  )
).sort((a, b) => Number(b[0]) - Number(a[0]));

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout title="Meng Wang | System and Firmware Security">
  <Header activeNav="home" />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">System &amp; firmware security</p>
      <h1>Meng Wang</h1>
      <p class="page-lead">
        Ph.D. student at
        <a class="text-link" href="https://cispa.de/en">
          CISPA Helmholtz Center for Information Security
        </a>
        advised by
        <a class="text-link" href="https://ali-abbasi.info/">Dr. Ali Abbasi</a>.
        My work focuses on system and firmware security. Previously, I worked
        with AWS Proactive Security on a web vulnerability scanner for AWS-owned
        websites.
      </p>

      <p class="hero-focus">{focusAreas.join("  ·  ")}</p>

      {
        socialCount > 0 && (
          <div class="hero-profiles">
            <span>Profiles</span>
            <Socials />
          </div>
        )
      }
    </section>

    <section class="content-section" aria-labelledby="research-heading">
      <h2 id="research-heading" class="section-title">Research</h2>
      <div class="research-grid">
        {
          workAreas.map(item => (
            <article class="research-item">
              <span class="research-bar" />
              <h3 class="research-title">{item.title}</h3>
              <p class="research-text">{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="content-section" aria-labelledby="news-heading">
      <h2 id="news-heading" class="section-title">News</h2>
      <div class="news-list">
        {
          newsByYear.map(([year, items]) => (
            <div class="news-group">
              <time class="news-year">{year}</time>
              <ul class="news-items">
                {items.map(text => (
                  <li>{text}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }

  .hero-focus {
    @apply mt-6 text-sm font-medium text-skin-accent;
  }

  .hero-profiles {
    @apply mt-8 flex items-center gap-3 text-sm text-skin-base/70;
  }

  /* Research — boxless columns, each topped with a small accent bar. */
  .research-grid {
    @apply grid gap-x-8 gap-y-9;
  }

  @media (min-width: 768px) {
    .research-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .research-bar {
    @apply mb-4 block h-1 w-10 rounded-full bg-skin-accent;
  }

  .research-title {
    @apply font-sans text-base font-semibold leading-snug tracking-[-0.01em];
  }

  .research-text {
    @apply mt-2 font-sans text-sm leading-7 text-skin-base/75;
  }

  /* News — grouped by year, year as a bold accent label, no dividers. */
  .news-list {
    @apply grid gap-7;
  }

  .news-group {
    @apply flex flex-col gap-x-6 gap-y-2 sm:flex-row;
  }

  .news-year {
    @apply shrink-0 text-lg font-semibold tabular-nums text-skin-accent sm:w-16;
  }

  .news-items {
    @apply grid gap-2.5;
  }

  .news-items li {
    @apply font-sans leading-7 text-skin-base/85;
  }
</style>
