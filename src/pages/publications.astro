---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";

const publications = [
  {
    venue: "OSDI '26",
    title: "μUSB: Practical and Safe USB Driver Reuse for Arm TrustZone",
    href: "https://www.usenix.org/conference/osdi26/presentation/zhang-xuankai",
    conference:
      "USENIX Symposium on Operating Systems Design and Implementation",
    authors: [
      "Xuankai Zhang",
      "Sijin Li",
      "Pei Meng",
      "Meng Wang",
      "Yongzhao Zhang",
      "Ting Chen",
      "Xiaosong Zhang",
      "Liwei Guo",
    ],
  },
  {
    venue: "CCS '26",
    title:
      "PyFEX: Uncovering Evasive Python-based Threats via Resilient and Exhaustive Path Exploration",
    href: "https://www.sigsac.org/ccs/CCS2026/call-for/call-for-papers.html",
    conference: "ACM SIGSAC Conference on Computer and Communications Security",
    authors: [
      "Meng Wang",
      "Yue Ma",
      "Majid Garoosi",
      "Wenting Fan",
      "Liwei Guo",
      "Jianqiang Wang",
      "Ali Abbasi",
    ],
  },
  {
    venue: "NDSS '26",
    title:
      "Anota: Identifying Business Logic Vulnerabilities via Annotation-Based Sanitization",
    href: "https://www.ndss-symposium.org/ndss-paper/anota-identifying-business-logic-vulnerabilities-via-annotation-based-sanitization/",
    conference: "Network and Distributed System Security Symposium",
    authors: [
      "Meng Wang",
      "Philipp Görz",
      "Joschua Schilling",
      "Keno Hassler",
      "Liwei Guo",
      "Thorsten Holz",
      "Ali Abbasi",
    ],
  },
  {
    venue: "SP '26",
    title:
      "SmuFuzz: Enable Deep System Management Mode Fuzzing in Fully Featured UEFI Runtime Environment",
    href: "https://sp2026.ieee-security.org/",
    conference: "IEEE Symposium on Security and Privacy",
    authors: [
      "Jianqiang Wang",
      "Yi Xiang",
      "Meng Wang",
      "Qinying Wang",
      "Ali Abbasi",
      "Thorsten Holz",
    ],
  },
  {
    venue: "NDSS '25",
    title:
      "TWINFUZZ: Differential Testing of Video Hardware Acceleration Stacks",
    href: "https://www.ndss-symposium.org/wp-content/uploads/2025-526-paper.pdf",
    conference: "Network and Distributed System Security Symposium",
    authors: [
      "Matteo Leonelli",
      "Addison Crump",
      "Meng Wang",
      "Florian Bauckholt",
      "Keno Hassler",
      "Ali Abbasi",
      "Thorsten Holz",
    ],
  },
  {
    venue: "NDSS '25",
    title: "A Comprehensive Memory Safety Analysis of Bootloaders",
    href: "https://www.ndss-symposium.org/wp-content/uploads/2025-330-paper.pdf",
    conference: "Network and Distributed System Security Symposium",
    authors: [
      "Jianqiang Wang",
      "Meng Wang",
      "Qinying Wang",
      "Nils Langius",
      "Li Shi",
      "Ali Abbasi",
      "Thorsten Holz",
    ],
  },
  {
    venue: "CCS '21",
    title: "Spinner: Automated Dynamic Command Subsystem Perturbation",
    href: "https://dl.acm.org/doi/pdf/10.1145/3460120.3484577",
    conference: "ACM SIGSAC Conference on Computer and Communications Security",
    authors: ["Meng Wang", "Chijung Jung", "Ali Ahad", "Yonghwi Kwon"],
  },
];
---

<Layout title="Publications | Meng Wang">
  <Header activeNav="publications" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">Selected work</p>
      <h1>Publications</h1>
    </section>

    <section class="content-section" aria-label="Publications">
      <div class="entry-list">
        {
          publications.map(publication => (
            <article class="entry pub">
              <div class="pub-venue-col">
                <span class="pub-venue">{publication.venue}</span>
                <span class="pub-conf">{publication.conference}</span>
              </div>
              <div class="pub-body">
                {publication.href ? (
                  <a
                    class="pub-title"
                    href={publication.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {publication.title}
                  </a>
                ) : (
                  <span class="pub-title">{publication.title}</span>
                )}
                <p class="pub-authors">
                  {publication.authors.map((author, index) => (
                    <>
                      {author === "Meng Wang" ? (
                        <strong class="author-self">{author}</strong>
                      ) : (
                        <span>{author}</span>
                      )}
                      {index < publication.authors.length - 1 && ", "}
                    </>
                  ))}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }

  .pub {
    @apply grid gap-x-6 gap-y-2;
  }

  @media (min-width: 768px) {
    .pub {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .pub-venue-col {
    @apply flex flex-col gap-1;
  }

  .pub-venue {
    @apply text-sm font-semibold tabular-nums text-skin-accent;
  }

  .pub-conf {
    @apply font-sans text-xs leading-snug text-skin-base/55;
  }

  .pub-title {
    @apply font-sans text-lg font-semibold leading-snug tracking-[-0.01em] decoration-2 underline-offset-4 transition-colors hover:text-skin-accent hover:underline;
    text-decoration-color: rgba(var(--color-accent), 0.35);
  }

  .pub-authors {
    @apply mt-1.5 font-sans text-sm leading-7 text-skin-base/80;
  }

  .author-self {
    @apply font-semibold text-skin-base;
  }
</style>
