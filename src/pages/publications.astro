---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";

const publications = [
  {
    venue: "CCS '26",
    title:
      "PyFEX: Uncovering Evasive Python-based Threats via Resilient and Exhaustive Path Exploration",
    href: "https://www.sigsac.org/ccs/CCS2026/call-for/call-for-papers.html",
    conference: "ACM SIGSAC Conference on Computer and Communications Security",
    authors: [
      "Meng Wang",
      "Yue Ma",
      "Majid Garoosi",
      "Wenting Fan",
      "Liwei Guo",
      "Jianqiang Wang",
      "Ali Abbasi",
    ],
  },
  {
    venue: "NDSS '26",
    title:
      "Anota: Identifying Business Logic Vulnerabilities via Annotation-Based Sanitization",
    href: "https://www.ndss-symposium.org/ndss-paper/anota-identifying-business-logic-vulnerabilities-via-annotation-based-sanitization/",
    conference: "Network and Distributed System Security Symposium",
    authors: [
      "Meng Wang",
      "Philipp Görz",
      "Joschua Schilling",
      "Keno Hassler",
      "Liwei Guo",
      "Thorsten Holz",
      "Ali Abbasi",
    ],
  },
  {
    venue: "SP '26",
    title:
      "SmuFuzz: Enable Deep System Management Mode Fuzzing in Fully Featured UEFI Runtime Environment",
    href: "https://sp2026.ieee-security.org/",
    conference: "IEEE Symposium on Security and Privacy",
    authors: [
      "Jianqiang Wang",
      "Yi Xiang",
      "Meng Wang",
      "Qinying Wang",
      "Ali Abbasi",
      "Thorsten Holz",
    ],
  },
  {
    venue: "NDSS '25",
    title:
      "TWINFUZZ: Differential Testing of Video Hardware Acceleration Stacks",
    href: "https://www.ndss-symposium.org/wp-content/uploads/2025-526-paper.pdf",
    conference: "Network and Distributed System Security Symposium",
    authors: [
      "Matteo Leonelli",
      "Addison Crump",
      "Meng Wang",
      "Florian Bauckholt",
      "Keno Hassler",
      "Ali Abbasi",
      "Thorsten Holz",
    ],
  },
  {
    venue: "NDSS '25",
    title: "A Comprehensive Memory Safety Analysis of Bootloaders",
    href: "https://www.ndss-symposium.org/wp-content/uploads/2025-330-paper.pdf",
    conference: "Network and Distributed System Security Symposium",
    authors: [
      "Jianqiang Wang",
      "Meng Wang",
      "Qinying Wang",
      "Nils Langius",
      "Li Shi",
      "Ali Abbasi",
      "Thorsten Holz",
    ],
  },
  {
    venue: "CCS '21",
    title: "Spinner: Automated Dynamic Command Subsystem Perturbation",
    href: "https://dl.acm.org/doi/pdf/10.1145/3460120.3484577",
    conference:
      "ACM SIGSAC Conference on Computer and Communications Security",
    authors: ["Meng Wang", "Chijung Jung", "Ali Ahad", "Yonghwi Kwon"],
  },
] as const;
---

<Layout title="Publications | Meng Wang">
  <Header activeNav="publications" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">Selected work</p>
      <h1>Publications</h1>
      <p>
        Peer-reviewed work on system security, firmware analysis, fuzzing, and
        vulnerability discovery.
      </p>
    </section>

    <section class="publication-list" aria-label="Publications">
      {
        publications.map(publication => (
          <article class="publication-card">
            <div class="venue-badge">{publication.venue}</div>
            <div class="card-content">
              <h2>
                {publication.href ? (
                  <a href={publication.href} target="_blank" rel="noreferrer">
                    {publication.title}
                  </a>
                ) : (
                  publication.title
                )}
              </h2>
              <p class="authors">
                {publication.authors.map((author, index) => (
                  <>
                    {author === "Meng Wang" ? (
                      <strong class="author-self">{author}</strong>
                    ) : (
                      <span>{author}</span>
                    )}
                    {index < publication.authors.length - 1 && ", "}
                  </>
                ))}
              </p>
              <p class="conference">{publication.conference}</p>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }

  .page-hero {
    @apply mx-auto max-w-none px-0 pb-10 pt-8;
  }

  .page-hero h1 {
    @apply text-5xl font-bold tracking-[-0.07em] sm:text-6xl;
  }

  .page-hero p:last-child {
    @apply mt-5 max-w-3xl text-lg leading-8 text-skin-base/75;
  }

  .eyebrow {
    @apply mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-skin-accent;
  }

  .publication-list {
    @apply grid gap-4;
  }

  .publication-card {
    @apply grid gap-4 rounded-[1.5rem] border border-skin-line bg-skin-fill/85 p-5 shadow-[0_18px_54px_rgba(15,23,42,0.07)] backdrop-blur transition duration-200 hover:-translate-y-1 hover:border-skin-accent/60 sm:grid-cols-[6rem_minmax(0,1fr)] sm:p-6;
  }

  .venue-badge {
    @apply flex h-14 w-24 items-center justify-center rounded-2xl bg-skin-card/60 text-sm font-bold text-skin-accent sm:w-full;
  }

  .card-content h2 {
    @apply text-xl font-semibold leading-snug tracking-[-0.03em];
  }

  .card-content h2 a {
    @apply decoration-2 underline-offset-4 transition-colors hover:text-skin-accent hover:underline;
    text-decoration-color: rgba(var(--color-accent), 0.35);
  }

  .authors {
    @apply mt-4 leading-7 text-skin-base/80;
  }

  .author-self {
    @apply rounded-full bg-skin-accent px-2 py-0.5 font-semibold text-skin-inverted;
  }

  .conference {
    @apply mt-3 text-sm font-medium uppercase tracking-[0.16em] text-skin-base/60;
  }
</style>
