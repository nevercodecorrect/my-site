---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";

const teachingItems = [
  {
    course: "System Security",
    role: "Teaching Assistant",
    institution: "Universität Hamburg",
    location: "Hamburg",
    period: "Sep 2024 - Mar 2025",
    description:
      "Supported instruction for system security topics, including vulnerability analysis and low-level security concepts.",
  },
  {
    course: "System Security",
    role: "Teaching Assistant",
    institution: "Universität des Saarlandes",
    location: "Saarbrücken",
    period: "Sep 2023 - Mar 2024",
    description:
      "Supported coursework and student learning in system security.",
  },
  {
    course: "Operating System",
    role: "Teaching Assistant",
    institution: "University of Virginia",
    location: "Charlottesville",
    period: "Sep 2021 - Mar 2022",
    description:
      "Supported operating systems coursework with emphasis on core OS concepts and systems programming.",
  },
] as const;
---

<Layout title="Teaching | Meng Wang">
  <Header activeNav="teaching" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">Instruction</p>
      <h1>Teaching</h1>
      <!-- <p>
        Courses where I have supported system security and operating systems
        instruction.
      </p> -->
    </section>

    <section class="timeline-section" aria-labelledby="teaching-heading">
      <div class="section-heading">
        <p class="eyebrow">Teaching assistantships</p>
        <h2 id="teaching-heading">Courses</h2>
      </div>

      <div class="timeline">
        {
          teachingItems.map(item => (
            <article class="timeline-card">
              <p class="period">{item.period}</p>
              <h3>{item.course}</h3>
              <p class="role">{item.role}</p>
              <p class="organization">
                {item.institution}
                <span>{item.location}</span>
              </p>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }

  .page-hero {
    @apply mx-auto max-w-none px-0 pb-10 pt-8;
  }

  .page-hero h1 {
    @apply text-5xl font-bold tracking-[-0.07em] sm:text-6xl;
  }

  .page-hero p:last-child {
    @apply mt-5 max-w-2xl text-lg leading-8 text-skin-base/75;
  }

  .eyebrow {
    @apply mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-skin-accent;
  }

  .timeline-section {
    @apply mx-auto max-w-none px-0 py-8;
  }

  .section-heading {
    @apply mb-6;
  }

  .section-heading h2 {
    @apply text-3xl font-bold tracking-[-0.04em];
  }

  .timeline {
    @apply relative grid gap-4 border-l border-skin-line pl-5;
  }

  .timeline-card {
    @apply relative rounded-[1.25rem] border border-skin-line bg-skin-fill/85 p-5 shadow-[0_16px_48px_rgba(15,23,42,0.07)] backdrop-blur;
  }

  .timeline-card::before {
    content: "";
    @apply absolute -left-[1.75rem] top-7 h-3 w-3 rounded-full border-2 border-skin-fill bg-skin-accent;
  }

  .period {
    @apply mb-3 inline-flex rounded-full bg-skin-card/60 px-3 py-1 text-xs font-semibold text-skin-accent;
  }

  .timeline-card h3 {
    @apply text-xl font-semibold tracking-[-0.03em];
  }

  .role {
    @apply mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-skin-accent;
  }

  .organization {
    @apply mt-2 font-medium text-skin-base/80;
  }

  .organization span {
    @apply ml-2 text-sm font-normal text-skin-base/55;
  }

  .timeline-card p:last-child {
    @apply mt-4 leading-7 text-skin-base/70;
  }
</style>
