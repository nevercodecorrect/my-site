---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";

// Render hyphenated date ranges with a proper en dash.
const dateRange = (s: string) => s.replace(/\s*-\s*/g, " – ");

const teachingItems = [
  {
    course: "System Security",
    role: "Teaching Assistant",
    institution: "Universität Hamburg",
    location: "Hamburg",
    period: "Sep 2024 - Mar 2025",
    description:
      "Supported instruction for system security topics, including vulnerability analysis and low-level security concepts.",
  },
  {
    course: "System Security",
    role: "Teaching Assistant",
    institution: "Universität des Saarlandes",
    location: "Saarbrücken",
    period: "Sep 2023 - Mar 2024",
    description:
      "Supported coursework and student learning in system security.",
  },
  {
    course: "Operating System",
    role: "Teaching Assistant",
    institution: "University of Virginia",
    location: "Charlottesville",
    period: "Sep 2021 - Mar 2022",
    description:
      "Supported operating systems coursework with emphasis on core OS concepts and systems programming.",
  },
] as const;
---

<Layout title="Teaching | Meng Wang">
  <Header activeNav="teaching" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="page-hero">
      <p class="eyebrow">Instruction</p>
      <h1>Teaching</h1>
    </section>

    <section class="content-section" aria-labelledby="teaching-heading">
      <h2 id="teaching-heading" class="section-title">Courses</h2>
      <div class="entry-list">
        {
          teachingItems.map(item => (
            <article class="entry">
              <div class="entry-row">
                <p class="entry-main">
                  <span class="entry-title">{item.course}</span>
                  <span class="entry-org">{item.institution}</span>
                  <span class="entry-loc">{item.location}</span>
                </p>
                <p class="entry-meta">{dateRange(item.period)}</p>
              </div>
              <p class="entry-desc">
                {item.role} — {item.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }
</style>
